# OWS V3 API (получить на: https://ows.goszakup.gov.kz)
OWS_TOKEN=your_ows_token_here
OWS_BASE_URL=https://ows.goszakup.gov.kz

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=tender_radar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@postgres:5432/tender_radar

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated; use * for dev only. Production example:
# CORS_ORIGINS=https://tender-radar.online
# Optional regex (also allows www): defaults in config to tender-radar.online apex + www.
# Set CORS_ORIGIN_REGEX=- to disable regex and use only CORS_ORIGINS.
CORS_ORIGINS=http://localhost:3000

# ETL Settings
ETL_BACKFILL_DATE_FROM=2024-01-01
ETL_BACKFILL_DATE_TO=2025-12-31
ETL_RATE_LIMIT_DELAY=0.5
ETL_MAX_RETRIES=3
ETL_PAGE_SIZE=50
ETL_BOOTSTRAP_LIMIT=10000

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# OpenAI (LLM explanation — NOT used for scoring)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1000
LLM_RISK_THRESHOLD=0.0
LLM_UNCERTAINTY_LOW=0.45
LLM_UNCERTAINTY_HIGH=0.55

# ML Model
ML_MODEL_PATH=ml_artifacts/model.pkl
ML_RULES_WEIGHT=0.6
ML_ML_WEIGHT=0.4
